# Copy to .env and fill in. All keys are prefixed BRAIN_. Do NOT commit real secrets.

# trading_hands HTTP API (the execution layer)
BRAIN_TRADING_HANDS_URL=http://127.0.0.1:4000
BRAIN_HTTP_TIMEOUT_SECONDS=10

# PostgreSQL — TWO DIFFERENT roles (published on 127.0.0.1:5433):
#   BRAIN_DB_DSN       = the least-privilege APP role (DML only on trading_brain). The
#                        runtime uses this. bootstrap creates this role from these creds.
#   BRAIN_ADMIN_DB_DSN = a PRIVILEGED role on a maintenance db (postgres). Used ONLY by
#                        bootstrap (CREATE DATABASE/ROLE) and migrate (DDL + grants).
# The two must be DIFFERENT users. Setup (once):
#   python -m database.bootstrap   # admin creates db + app role, grants CONNECT
#   python -m database.migrate     # admin runs DDL, grants DML to the app role
BRAIN_DB_DSN=postgresql://trading_brain_app:APP_PASSWORD@127.0.0.1:5433/trading_brain
BRAIN_ADMIN_DB_DSN=postgresql://ADMIN_USER:ADMIN_PASSWORD@127.0.0.1:5433/postgres

# Asset under analysis. Use the EXACT XTB symbol. The /instruments search is fuzzy;
# GOLD is mapped to the provider symbol via BRAIN_PROVIDER_SYMBOL_MAP (default C:XAUUSD).
BRAIN_SYMBOL_QUERY=GOLD

# Market-data provider: "polygon" (Massive/Polygon.io) or "csv" (offline).
BRAIN_MARKET_DATA_PROVIDER=polygon
# Polygon API key (secret — keep it in .env, never in .env.example / version control).
BRAIN_POLYGON_API_KEY=your-polygon-key-here
BRAIN_POLYGON_BASE_URL=https://api.polygon.io
# Client-side spacing between provider requests. Free tier ~5 req/min -> keep ~13s;
# set to 0 on a paid plan.
BRAIN_POLYGON_MIN_INTERVAL_SECONDS=13
# Offline CSV source directory (only when BRAIN_MARKET_DATA_PROVIDER=csv):
# BRAIN_CSV_DIR=/path/to/csv

# Decision eligibility. "online" = freshness vs the wall clock (Shadow Online);
# "replay" = freshness vs as_of (dev/replay). The free tier is DELAYED, so online
# snapshots are (correctly) flagged stale — online readiness is blocked until a
# real-time feed is chosen. Keep "replay" for development.
BRAIN_MARKET_MODE=replay
BRAIN_ELIGIBILITY_MAX_FEED_LAG_SECONDS=1800
BRAIN_ELIGIBILITY_MAX_QUOTE_LAG_SECONDS=120

# LLM decision layer (Faza 2). One configurable baseline model; the benchmark runs on the
# SAME frozen inputs. Keep the key in .env only, NEVER in this template.
BRAIN_ANTHROPIC_API_KEY=your-anthropic-key-here
BRAIN_DECISION_MODEL=claude-sonnet-5
BRAIN_BENCHMARK_MODEL=claude-opus-4-8
BRAIN_DECISION_MAX_TOKENS=1024
