# Copy to `.env.brain` — NON-SECRET runtime settings passed into the app containers (dashboard,
# collector, online) via docker-compose env_file. NEVER put secrets here (passwords, API keys,
# DSNs) — those live in .env.compose and are used only to assemble the scoped DSNs.

# Market data + upstreams (non-secret).
BRAIN_MARKET_DATA_PROVIDER=xtb
BRAIN_TRADING_HANDS_URL=http://host.docker.internal:4000
# BRAIN_CSV_DIR=/data/csv

# Shadow Online / experiment.
# BRAIN_RUN_ID=release-2026.07
BRAIN_RECONCILE_TIMEFRAME=15min
BRAIN_SYMBOL_QUERY=GOLD

# Financing model (rates from the XTB account spec; see .env.example for semantics).
BRAIN_COMMISSION_PCT=0.0
BRAIN_SWAP_PCT_PER_NIGHT=0.0
BRAIN_ROLLOVER_HOUR_UTC=22
BRAIN_ROLLOVER_TZ=UTC
BRAIN_FINANCING_TERMS_VERSION=unset
# BRAIN_SWAP_LONG_PCT_PER_NIGHT=0.0
# BRAIN_SWAP_SHORT_PCT_PER_NIGHT=0.0
# BRAIN_TRIPLE_SWAP_WEEKDAY=2
