# Copy to `.env.compose` and edit. The Makefile passes this file to compose via --env-file,
# so it stays separate from the local-run `.env`. NEVER commit the filled-in `.env.compose`.

# PostgreSQL superuser (admin). Used only to create the DB + app role and run DDL/migrations.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_admin

# Least-privilege application role (runtime DML only). `migrate` creates it on first `up`
# with exactly this password; the app services then connect as it.
BRAIN_APP_USER=trading_brain_app
BRAIN_APP_PASSWORD=change_me_app
BRAIN_DB_NAME=trading_brain

# Host-side published ports (loopback only).
BRAIN_DB_PORT=5433
BRAIN_DASHBOARD_PORT=8080

# Market data for the opt-in data loop (collector + shadow.online):
#   xtb     = real-time via a running trading_hands (same venue as execution)
#   polygon = Polygon/Massive REST (set BRAIN_POLYGON_API_KEY)
#   csv     = offline files (set BRAIN_CSV_DIR and mount it)
BRAIN_MARKET_DATA_PROVIDER=xtb
BRAIN_TRADING_HANDS_URL=http://host.docker.internal:4000
# BRAIN_POLYGON_API_KEY=
# BRAIN_CSV_DIR=

# Any BRAIN_* set here is passed into the container (docker-compose env_file). Common overrides —
# see .env.example for the full list and semantics:
# BRAIN_RUN_ID=release-2026.07           # pin the online experiment to this config
# BRAIN_RECONCILE_TIMEFRAME=15min        # 1min needs a provider that serves M1
# BRAIN_DECISION_MODEL=claude-opus-4-8   # only used with --maker claude
# BRAIN_COMMISSION_PCT=0.0
# BRAIN_SWAP_PCT_PER_NIGHT=0.0
# BRAIN_ROLLOVER_TZ=UTC
# Verify what actually reached a container:  docker compose run --rm dashboard python -m config.dump
